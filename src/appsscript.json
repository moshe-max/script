    "drive": {
      "homepageTrigger": {
        "runFunction": "buildAddOn",
        "enabled": true
      },
      "onItemsSelectedTrigger": {
        "runFunction": "buildAddOn"
      }
    },
    "calendar": {
      "homepageTrigger": {
        "runFunction": "buildAddOn",
        "enabled": true
      }
    },
    "docs": {
      "homepageTrigger": {
        "runFunction": "buildAddOn",
        "enabled": true
      }
    },
    "sheets": {
      "homepageTrigger": {
        "runFunction": "buildAddOn",
        "enabled": true
      }
    },
    "slides": {
      "homepageTrigger": {
        "runFunction": "buildAddOn",
        "enabled": true
      }
    }
  }
}